# Bu dosyayı ".env" olarak kopyala ve kendi anahtarlarını gir.
# .env dosyasını ASLA git'e / paylaşıma ekleme.

# Zorunlu: Google Gemini API anahtarı (RIFKI'nın "beyni")
# https://aistudio.google.com/apikey adresinden ücretsiz alınır.
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Kullanılacak model (function calling destekleyen bir model olmalı).
# NOT: Google model isimlerini zaman zaman günceller/emekliye ayırır.
# Güncel liste için https://ai.google.dev/gemini-api/docs/models adresine bak.
GEMINI_MODEL=gemini-2.5-flash

# Wake word (uyandırma kelimesi) - küçük harf
WAKE_WORD=rıfkı

# Konuşma tanıma dili (Google Speech Recognition dil kodu)
STT_LANGUAGE=tr-TR

# Sesli yanıt motoru: "gtts" (online, doğal Türkçe) veya "pyttsx3" (offline, robotik)
TTS_ENGINE=gtts

# Log seviyesi: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO