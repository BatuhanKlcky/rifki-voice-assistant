<?xml version="1.0" encoding="utf-8"?>
<!--
  Aynı Wi‑Fi'de köprü http://LAN:8765 kullanır (Android domain-config CIDR desteklemez).
  Uzak erişim Cloudflare tunnel ile https tercih edilir.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
